{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "!.turbo/**", "!dist/**"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "!.turbo/**", "!dist/**"],
      "outputs": ["dist/**/*.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build:types"],
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
